NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/quefem.sqlite
GENCAT_SYNC_ENABLED=true
GENCAT_SYNC_CRON=
GENCAT_PAGE_SIZE=1000
TICKETMASTER_API_KEY=
TICKETMASTER_LOOKAHEAD_DAYS=90
TICKETMASTER_IMAGES_ENABLED=false
TICKETMASTER_IMAGE_CACHE_PATH=./data/cache/ticketmaster-images
TICKETMASTER_IMAGE_CACHE_TTL_HOURS=6
TICKETMASTER_IMAGE_CACHE_MAX_MB=512
TICKETMASTER_IMAGE_METADATA_REFRESH_HOURS=24
TICKETMASTER_IMAGE_REQUEST_TIMEOUT_MS=15000
TICKETMASTER_IMAGE_MAX_BYTES=10485760
EVENT_RETENTION_DAYS=0
INACTIVE_PLAN_RETENTION_DAYS=7
DEFAULT_LANGUAGE=ca
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
FEVER_LOOKAHEAD_DAYS=365
FEVER_IMAGES_ENABLED=false
FEVER_IMAGE_CACHE_PATH=./data/cache/fever-images
FEVER_IMAGE_CACHE_TTL_HOURS=6
FEVER_IMAGE_CACHE_MAX_MB=512
FEVER_IMAGE_REQUEST_TIMEOUT_MS=15000
FEVER_IMAGE_MAX_BYTES=10485760
# Solo para `npm run fallback-images:fetch`; no se usa en el runtime ni en frontend.
PEXELS_API_KEY=
