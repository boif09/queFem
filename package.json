{
  "name": "que-fem",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline de dades de Què Fem?",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "db:init": "node backend/src/db/migrate.js",
    "db:purge": "node backend/src/jobs/purgeOldPlans.js",
    "purge:inactive": "node backend/src/jobs/purgeInactivePlans.js",
    "import:gencat": "node backend/src/jobs/importGencat.js",
    "import:ticketmaster": "node backend/src/jobs/importTicketmaster.js",
    "fever:discovery:dry-run": "node backend/src/jobs/dryRunFeverDiscovery.js",
    "diba:discovery": "node scripts/dibaDiscovery.js",
    "diba:import": "node backend/src/jobs/importDiba.js",
    "diba:quality:audit": "node scripts/dibaQualityAudit.js",
    "diba:policy:dry-run": "node scripts/dibaPolicyDryRun.js",
    "fever:normalize:dry-run": "node backend/src/jobs/dryRunFeverNormalization.js",
    "geography:icgc:update": "node backend/src/jobs/updateIcgcGeography.js",
    "fever:geography:dry-run": "node backend/src/jobs/dryRunFeverGeography.js",
    "fever:import:temp": "node backend/src/jobs/importFeverTemp.js",
    "fever:import": "node backend/src/jobs/importFever.js",
    "fever:import:scheduled": "node backend/src/jobs/importFeverScheduled.js",
    "fever:benchmark:temp": "node backend/src/jobs/benchmarkFeverM5b.js",
    "ticketmaster:images:sync": "node backend/src/jobs/syncTicketmasterImages.js",
    "fallback-images:fetch": "node scripts/fetchFallbackImages.js",
    "fallback-images:prepare": "node scripts/prepareFallbackImages.js",
    "fallback-images:validate": "node scripts/prepareFallbackImages.js --validate",
    "fallback-images:build": "npm run fallback-images:fetch && npm run fallback-images:prepare -- --input data/fallback-image-originals && npm run fallback-images:validate",
    "ticketmaster:remove": "node backend/src/jobs/removeTicketmasterEvent.js",
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "vite frontend",
    "build:frontend": "vite build frontend",
    "preview:frontend": "vite preview frontend",
    "test:backend": "node --test test/*.test.js",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "entities": "^8.0.0",
    "express": "^5.1.0",
    "i18next": "^25.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.4.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.0.0",
    "supertest": "^7.1.4",
    "vite": "^8.1.0",
    "vitest": "^4.0.0"
  }
}
